# the measured free-tier limits (200 / 50 / 100); set them for a paid tier or a
# raised limit. A whole number, 0 blocks every call, anything else fails at
# startup.
# ORS_DAILY_LIMIT_DIRECTIONS=200
# ORS_DAILY_LIMIT_MATRIX=50
# ORS_DAILY_LIMIT_GEOCODING=100
AUTH_SECRET=
AUTH_URL=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_DISPLAY_NAME=
