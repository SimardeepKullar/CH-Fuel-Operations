{
  "name": "@ch/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/test/integration/**\"",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:real": "tsx src/db/migrate.ts ../migrations/real",
    "seed": "tsx src/cli/seed.ts",
    "ingest": "tsx src/cli/ingest.ts"
  },
  "dependencies": {
    "csv-parse": "^5.6.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "oxlint": "^1.79.0",
    "pdfkit": "^0.20.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
