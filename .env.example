# Copy to .env and fill in. Every .env* file except this one is gitignored.
#
# APP_ENV picks which files are loaded, from the repo root, in this order —
# the first file to set a key wins, and a variable already set in the shell
# is never overwritten:
#
#   .env.<APP_ENV>.local  →  .env.<APP_ENV>  →  .env
#
# One of development | test | real | preview | production; any other value
# fails at startup. Unset loads .env alone. APP_ENV is read from the shell
# only — an APP_ENV line in a file is ignored — so .env.production.local is
# read only when APP_ENV=production is set explicitly. Put shared settings
# here and only DATABASE_URL in each .env.<APP_ENV>:
#
#   .env.development       DATABASE_URL=postgres://ch_fuel:ch_fuel@localhost:5433/ch_fuel_dev
#   .env.test              DATABASE_URL=postgres://ch_fuel:ch_fuel@localhost:5433/ch_fuel_test
#   .env.real              DATABASE_URL=postgres://ch_fuel:ch_fuel@localhost:5433/ch_fuel_real
#   .env.production.local  the Neon production URL, for running prod migrations by hand
#
# Every entry point prints one line on startup naming the environment and the
# database host and name (never the credentials).
# APP_ENV=

DATABASE_URL=postgres://ch_fuel:ch_fuel@localhost:5433/ch_fuel_planner
ORS_API_KEY=
ROUTING_PROVIDER=ors
# Optional. ORS calls allowed per endpoint per UTC day (§8.3). Leave unset for
# the measured free-tier limits (200 / 50 / 100); set them for a paid tier or a
# raised limit. A whole number, 0 blocks every call, anything else fails at
# startup.
# ORS_DAILY_LIMIT_DIRECTIONS=200
# ORS_DAILY_LIMIT_MATRIX=50
# ORS_DAILY_LIMIT_GEOCODING=100
AUTH_SECRET=
AUTH_URL=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_DISPLAY_NAME=
